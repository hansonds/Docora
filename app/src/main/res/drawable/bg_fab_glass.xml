<?xml version="1.0" encoding="utf-8"?>
<!-- small frosted-glass circle: white, slightly see-through, fine edge -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#22000000">
    <item>
        <layer-list>
            <item>
                <shape android:shape="oval">
                    <gradient android:angle="270" android:startColor="#F2FFFFFF" android:endColor="#D9F3F5FA" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <stroke android:width="1dp" android:color="#26000000" />
                </shape>
            </item>
        </layer-list>
    </item>
</ripple>
