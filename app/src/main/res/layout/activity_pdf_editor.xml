<?xml version="1.0" encoding="utf-8"?>
<!-- PDF editor: the document fills the screen; glass bars float over it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.hanson.scansign.PdfDocView
        android:id="@+id/doc"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

        <TextView
            android:id="@+id/formBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="88dp"
            android:background="@drawable/bg_glass_dark"
            android:drawablePadding="8dp"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:text="This PDF has a form. Tap any highlighted field to type or tick it."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <EditText
            android:id="@+id/fieldEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_field_editor"
            android:importantForAutofill="no"
            android:paddingHorizontal="4dp"
            android:paddingVertical="0dp"
            android:textColor="#0A143C"
            android:visibility="gone" />

        <!-- Edit PDF (beta): type straight onto the page -->
        <EditText
            android:id="@+id/typeBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_type_box"
            android:gravity="top|start"
            android:importantForAutofill="no"
            android:includeFontPadding="false"
            android:inputType="textMultiLine|textCapSentences"
            android:padding="0dp"
            android:visibility="gone" />

        <!-- drag sideways to make the typing box longer or shorter -->
        <ImageView
            android:id="@+id/typeHandle"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/bg_done_fab"
            android:contentDescription="Drag to change the width"
            android:elevation="6dp"
            android:padding="5dp"
            android:src="@drawable/ic_width"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/textBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_glass_dark"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:visibility="gone">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selCopy"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Copy"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selAll"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Select all"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selShare"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Share"
                android:textColor="#FFFFFF" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/selTranslate"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:text="Translate"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- page counter: tap to jump to a page -->
        <TextView
            android:id="@+id/pagePill"
            android:layout_width="wrap_content"
            android:layout_height="34dp"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="110dp"
            android:background="@drawable/bg_page_chip"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:minWidth="76dp"
            android:paddingHorizontal="16dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- zoom + full screen rail -->
        <LinearLayout
            android:id="@+id/zoomBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="110dp"
            android:background="@drawable/bg_glass_dark"
            android:elevation="6dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnZoomIn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zoom in"
                android:src="@drawable/ic_zoom_in"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnZoomOut"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Zoom out"
                android:src="@drawable/ic_zoom_out"
                app:tint="#FFFFFF" />

            <View
                android:layout_width="22dp"
                android:layout_height="1dp"
                android:layout_marginVertical="4dp"
                android:background="#40FFFFFF" />

            <ImageButton
                android:id="@+id/btnFullscreen"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Full screen"
                android:src="@drawable/ic_fullscreen"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- undo / redo -->
        <LinearLayout
            android:id="@+id/undoBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="14dp"
            android:layout_marginBottom="110dp"
            android:background="@drawable/bg_glass_dark"
            android:elevation="6dp"
            android:orientation="horizontal"
            android:padding="4dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnUndo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Undo"
                android:src="@drawable/ic_undo"
                app:tint="#FFFFFF" />

            <ImageButton
                android:id="@+id/btnRedo"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Redo"
                android:src="@drawable/ic_redo"
                app:tint="#FFFFFF" />
        </LinearLayout>

        <!-- shown briefly in full screen -->
        <ImageButton
            android:id="@+id/btnExitFull"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|end"
            android:layout_margin="16dp"
            android:background="@drawable/bg_glass_round"
            android:contentDescription="Exit full screen"
            android:elevation="6dp"
            android:src="@drawable/ic_fullscreen_exit"
            android:visibility="gone"
            app:tint="#FFFFFF" />

        <LinearLayout
            android:id="@+id/loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_dark"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <ProgressBar
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:indeterminateTint="?attr/colorPrimary" />

            <TextView
                android:id="@+id/loadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Opening…"
                android:textColor="#FFFFFF" />
        </LinearLayout>

    <!-- floating top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:layout_margin="10dp"
        android:background="@drawable/bg_glass"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" />

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:minHeight="0dp"
            app:contentInsetStart="4dp"
            app:contentInsetStartWithNavigation="0dp"
            app:subtitleTextAppearance="@style/TextAppearance.Material3.BodySmall"
            app:titleTextAppearance="@style/TextAppearance.App.EditorTitle" />

    </LinearLayout>

    <!-- find in document -->
    <LinearLayout
        android:id="@+id/findBar"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_gravity="top"
        android:layout_margin="10dp"
        android:background="@drawable/bg_glass"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="6dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/findClose"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close search"
            android:src="@drawable/ic_back"
            app:tint="?attr/colorOnSurface" />

        <EditText
            android:id="@+id/findText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Find in document"
            android:imeOptions="actionSearch"
            android:importantForAutofill="no"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="6dp"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/findProgress"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginEnd="6dp"
            android:indeterminateTint="?attr/colorPrimary"
            android:visibility="gone" />

        <TextView
            android:id="@+id/findCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="2dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <ImageButton
            android:id="@+id/findPrev"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous match"
            android:src="@drawable/ic_chevron_up"
            app:tint="?attr/colorOnSurface" />

        <ImageButton
            android:id="@+id/findNext"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next match"
            android:src="@drawable/ic_chevron_down"
            app:tint="?attr/colorOnSurface" />
    </LinearLayout>

    <!-- floating tool dock -->
    <LinearLayout
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="10dp"
        android:background="@drawable/bg_glass"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingVertical="4dp">

            <!-- Edit PDF (beta) header -->
            <LinearLayout
                android:id="@+id/betaHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingTop="6dp"
                android:paddingEnd="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Edit PDF"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="@drawable/bg_beta_badge"
                            android:paddingHorizontal="5dp"
                            android:paddingVertical="1dp"
                            android:text="BETA"
                            android:textColor="#FFFFFF"
                            android:textSize="9sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/betaHint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:maxLines="2"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/betaSave"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="Save"
                    app:icon="@drawable/ic_save" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/betaDone"
                    style="@style/Widget.Material3.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="6dp"
                    android:text="Done"
                    app:icon="@drawable/ic_check" />
            </LinearLayout>

            <!-- options for the active drawing tool -->
            <LinearLayout
                android:id="@+id/toolOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="12dp"
                android:paddingTop="8dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/toolTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/toolDone"
                        style="@style/Widget.App.SecondaryButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="Done"
                        app:icon="@drawable/ic_check" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/shapeScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/shapeKinds"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:singleSelection="true" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/toolColors"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/widthLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="64dp"
                        android:text="Size"
                        android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />

                    <com.google.android.material.slider.Slider
                        android:id="@+id/toolWidth"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:stepSize="0.5"
                        android:value="2"
                        android:valueFrom="0.5"
                        android:valueTo="16" />
                </LinearLayout>
            </LinearLayout>

            <HorizontalScrollView
                android:id="@+id/toolsScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/tools"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp" />
            </HorizontalScrollView>

            <!-- Edit PDF (beta): style controls while typing on the page -->
            <LinearLayout
                android:id="@+id/typeBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp"
                android:visibility="gone">

                <HorizontalScrollView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/typeTools"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <ImageButton
                    android:id="@+id/typeCancel"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Cancel"
                    android:src="@drawable/ic_close"
                    app:tint="?attr/colorOnSurface" />

                <ImageButton
                    android:id="@+id/typeDone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="2dp"
                    android:background="@drawable/bg_done_fab"
                    android:contentDescription="Done"
                    android:src="@drawable/ic_check"
                    app:tint="#FFFFFF" />
            </LinearLayout>
    </LinearLayout>
</FrameLayout>
